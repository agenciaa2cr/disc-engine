{
  "name": "disc-engine",
  "version": "2.0.0",
  "description": "DISC 2.0 — instrumento, motor de escoragem e motor de laudo determinístico (sem IA)",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "demo:all": "tsx scripts/demo.ts --all-profiles",
    "server": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/src/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
